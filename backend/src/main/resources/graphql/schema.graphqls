# GraphQL API over the world engine (capability graphql-api).
# This slice (add-graphql-read-api) covers the whole read model plus world-lifecycle mutations;
# player / play / persistence-write mutations arrive in add-graphql-mutations.
# All types are application-layer DTOs — no simulation-engine record is exposed.

# 64-bit integer scalar (graphql-java-extended-scalars) for engine ids/seeds/targets that exceed Int.
scalar Long

type Query {
    "Read-only status of a world session by id."
    world(id: ID!): WorldStatus

    "The player's reviewable schedule of eligible upcoming events (empty when no player is assigned)."
    playerSchedule(id: ID!): [ScheduleEntry!]!

    "Current, actionable career attention for the human player; this read never changes career state."
    careerInbox(id: ID!): CareerInbox!

    "The player's career goals with live progress (empty when none chosen)."
    careerGoals(id: ID!): [CareerGoal!]!

    "The player's achievements: the full catalogue in display order, each with this player's unlock state (empty when no player is assigned)."
    achievements(id: ID!): [Achievement!]!

    "The player's season calendar: each eligible event with its name and entry status, marked played once resolved, with the result once played (empty when no player is assigned)."
    playerCalendar(id: ID!): [CalendarEntry!]!

    "The player's golfer profile — identity, attributes, ranking, earnings; null when no player is assigned."
    playerProfile(id: ID!): PlayerProfile

    "The player's per-season statistics, one row per season competed (empty when no player is assigned)."
    playerSeasonStats(id: ID!): [SeasonStat!]!

    "A completed season's off-season review (the end-of-season moment). `season` defaults to the most recently completed one; null when no season has completed yet or no player is assigned."
    seasonReview(id: ID!, season: Int): SeasonReview

    "The player's current development focus — the attribute enum names being prioritised (empty when unset)."
    playerDevelopmentFocus(id: ID!): [String!]!

    "The player's attribute gains from their most recently developed season (the end-of-season report)."
    developmentReport(id: ID!): [DevelopmentDelta!]!

    "The player's banked Development Points and the cost-curve constants (for previewing spend costs)."
    playerDevelopment(id: ID!): PlayerDevelopment!

    "The world's Hall-of-Fame inductions so far."
    hallOfFame(id: ID!): [HallOfFameInduction!]!

    "The current World Ranking, top `limit` golfers by ranking value (name-enriched)."
    worldRankings(id: ID!, limit: Int = 100): [RankingRow!]!

    "The player's fitness — condition, fatigue, availability, and any active injury; null when no player is assigned."
    playerFitness(id: ID!): PlayerFitness

    "The world Record Book — the current holder of each record (name-enriched)."
    records(id: ID!): [WorldRecord!]!

    "The player's career records — headline totals, scoring bests, and per-event history (their historical dominance of recurring events); null when no player is assigned."
    careerRecords(id: ID!): CareerRecords

    "Recent world news (tournament results, milestones, promotions, retirements…), most recent first."
    newsFeed(id: ID!, limit: Int = 20): [NewsItem!]!

    "The player's pending sponsorship offers awaiting a decision."
    pendingSponsorships(id: ID!): [SponsorshipOffer!]!

    "The player's sponsorship book — the concurrency cap and currently-active agreements; null when no player is assigned."
    sponsorshipStatus(id: ID!): SponsorshipStatus

    "The player's pending staff candidates awaiting a hire decision."
    pendingStaff(id: ID!): [StaffMember!]!

    "The player's current support-team roster (empty when no player is assigned)."
    playerStaff(id: ID!): [StaffMember!]!

    "The player's pending equipment upgrade offers awaiting a purchase decision."
    pendingEquipment(id: ID!): [EquipmentItem!]!

    "Every item the player currently owns, across all equipment categories (empty when no player is assigned)."
    playerEquipment(id: ID!): [EquipmentItem!]!

    "The item the player currently has selected in each equipment category (empty when no player is assigned)."
    playerLoadout(id: ID!): [EquipmentItem!]!

    "The player's equipment brand-deal offers awaiting a decision (empty while under an active deal or with no player)."
    pendingEquipmentDeals(id: ID!): [EquipmentDeal!]!

    "The player's active equipment brand deal, or null when they are a free agent / no player is assigned."
    activeEquipmentDeal(id: ID!): EquipmentDeal

    "The current shot situation in a paused player event; null when no event is pending."
    currentSituation(id: ID!): ShotSituation

    "Presentation context for the paused player event — its name, place, and host course type; null when no event is pending."
    currentEvent(id: ID!): CurrentEvent

    "Geometry of a hole in the paused player event for rendering — the current hole, or an explicit hole (1..18) for pre-fetch; null when no event is pending or it is played to the end."
    playingHole(id: ID!, hole: Int): PlayingHole

    "The live leaderboard for a paused player event; empty when no event is pending."
    eventLeaderboard(id: ID!): [LeaderboardRow!]!

    "The player's current-round scorecard in a paused player event; null when no round is in progress."
    playerScorecard(id: ID!): RoundScorecard

    "Whether the player made the cut in the pending event; null when no event is pending or the cut is not yet decided."
    playerMadeCut(id: ID!): Boolean

    "The situational pressure [0,1] the player currently feels in their event (0 outside contention/closing rounds, peak in a playoff); null when no event is pending."
    playerPressure(id: ID!): Float

    "Every stored saved game's metadata, newest first."
    listSaves: [Save!]!
}

type Mutation {
    # --- World lifecycle (add-graphql-read-api) ---

    "Creates a new world session from a seed, optionally with an explicit configuration; returns its status."
    createWorld(seed: Long!, config: WorldConfigInput): WorldStatus!

    "Advances a session by one full season; returns the new status."
    advanceSeason(id: ID!): WorldStatus!

    "Advances a session by one week; returns the new status."
    advanceWeek(id: ID!): WorldStatus!

    # --- Player control (add-graphql-mutations). Enum args use engine enum names. ---

    "Designates an existing golfer as the human-controlled player."
    assignPlayer(id: ID!, golferId: ID!): Boolean!

    "Creates a custom human golfer (nationality/archetype as enum names) as the session's player; returns its id."
    createPlayer(id: ID!, firstName: String!, lastName: String!, nationality: String!, startAge: Int!, archetype: String!, handedness: String): ID!

    "Sets the player's development focus (an ordered list of Attribute enum names)."
    setDevelopmentFocus(id: ID!, focus: [String!]!): Boolean!

    "Spends banked Development Points to raise attributes; returns the new balance. Rejects an unaffordable request."
    spendDevelopmentPoints(id: ID!, raises: [AttributeRaiseInput!]!): Int!

    "Sets whether the player's golfer is resting (a blanket sit-out)."
    setResting(id: ID!, resting: Boolean!): Boolean!

    "Records that the player completed the current season's Schedule review; it changes no schedule decision."
    acknowledgeScheduleReview(id: ID!): Boolean!

    "Records that the player reviewed this season's optional Staff candidates; it changes no staff decision."
    acknowledgeStaffReview(id: ID!): Boolean!

    "Skips a specific upcoming event by tournament id for the player."
    skipEvent(id: ID!, tournamentId: Long!): Boolean!

    "Re-enters a previously skipped event for the player."
    enterEvent(id: ID!, tournamentId: Long!): Boolean!

    "Sets the player's self-chosen career goals."
    setCareerGoals(id: ID!, goals: [CareerGoalInput!]!): Boolean!

    "Accepts a pending sponsorship offer by index."
    acceptSponsorship(id: ID!, index: Int!): Boolean!

    "Hires a pending staff candidate by index (if affordable)."
    hireStaff(id: ID!, index: Int!): Boolean!

    "Releases a current staff member by role (a StaffRole enum name)."
    releaseStaff(id: ID!, role: String!): Boolean!

    "Buys a pending equipment upgrade by index (if affordable); auto-equips it."
    buyEquipment(id: ID!, index: Int!): Boolean!

    "Signs a pending equipment brand deal by index: pays the signing bonus, kits + equips the brand's bag, locks in for the term."
    acceptEquipmentDeal(id: ID!, index: Int!): Boolean!

    "Switches the tournament loadout to an already-owned item, addressed by its category (an EquipmentCategory enum name) and name."
    selectLoadoutItem(id: ID!, category: String!, name: String!): Boolean!

    # --- Playable event (add-graphql-mutations) ---

    "Plays the current shot from an individual club and canonical intended-contact point."
    playShot(id: ID!, intent: BallStrikeIntentInput!): ShotSubmission!

    "Uses the existing dedicated, non-spatial putting model from green or fringe."
    playPutt(id: ID!, expectedShotRevision: String!): ShotSubmission!

    "Sims the current shot in the player's event; returns the resolved outcome."
    simShot(id: ID!): ShotOutcome!

    "Sims the rest of the current hole in the player's event."
    simHole(id: ID!): Boolean!

    "Sims the rest of the current round in the player's event."
    simRound(id: ID!): Boolean!

    "Sims the remainder of the player's event (all remaining rounds and any playoff)."
    simEvent(id: ID!): Boolean!

    "Completes the player's finished event so its result counts and the paused week resumes; returns the new status."
    completeEvent(id: ID!): WorldStatus!

    # --- Persistence writes (add-graphql-mutations) ---

    "Saves a session to durable storage under a save id."
    save(id: ID!, saveId: ID!): Boolean!

    "Loads a save into a new session; returns the restored session's status (including its new id)."
    load(saveId: ID!): WorldStatus!

    "Deletes a stored save."
    deleteSave(saveId: ID!): Boolean!
}

type WorldStatus {
    id: ID!
    season: Int!
    week: Int!
    activePopulation: Int!
    hasPendingEvent: Boolean!
    "True when the pending event has been played to its end and only awaits completion (the finish-event window)."
    pendingEventFinished: Boolean!
}

type Golfer {
    id: ID!
    name: String!
}

type ScheduleEntry {
    tournamentId: Long!
    week: Int!
    tier: String!
    prestige: String!
    entered: Boolean!
    "The event's realistic display name."
    name: String!
    "The event's place — a major's hinting location, or the host course's region."
    location: String!
    "The host course's environment classification (e.g. PARKLAND, LINKS, DESERT) — drives scene imagery."
    courseType: String!
}

"A compact, current-state set of personal career attention items."
type CareerInbox {
    items: [CareerInboxItem!]!
}

"One aggregated attention source and the number of actionable underlying choices."
type CareerInboxItem {
    kind: CareerInboxKind!
    count: Int!
}

enum CareerInboxKind {
    SCHEDULE
    DEVELOPMENT
    SPONSORSHIP
    EQUIPMENT
    STAFF
}

type CalendarEntry {
    tournamentId: Long!
    week: Int!
    tier: String!
    prestige: String!
    entered: Boolean!
    name: String!
    "The event's place — a major's hinting location, or the host course's region."
    location: String!
    "Whether the event has been played (its result is available)."
    played: Boolean!
    "The event's result once played; null while it is upcoming."
    result: EventResult
}

type EventResult {
    winner: Finisher
    "The leading finishers (up to three)."
    topThree: [Finisher!]!
    "The player's own finish; null when they were not in the field (skipped or ineligible)."
    playerFinish: Finisher
}

type Finisher {
    position: Int!
    name: String!
    "Score relative to par."
    score: Int!
    madeCut: Boolean!
    earnings: Float!
}

type CareerGoal {
    type: String!
    target: Long!
    current: Long!
    achieved: Boolean!
}

"A career achievement from the fixed catalogue, with this player's unlock state."
type Achievement {
    "Stable catalogue id (the enum name), e.g. ACE_IN_THE_HOLE."
    id: String!
    "Category grouping (enum name): MILESTONE, ON_COURSE, CLUTCH, PROGRESSION, QUIRKY."
    category: String!
    "Human-facing category heading, e.g. \"On-Course Feats\"."
    categoryLabel: String!
    title: String!
    "One-line description; null for a still-locked secret achievement (hidden until earned)."
    description: String
    "Whether this is a secret achievement (its description is withheld until it is unlocked)."
    secret: Boolean!
    unlocked: Boolean!
    "The season this achievement was unlocked; null while still locked."
    seasonUnlocked: Int
}

"The player's career records — the player-specific counterpart to the world Record Book (spec: career-records)."
type CareerRecords {
    summary: CareerRecordsSummary!
    "One entry per distinct event the player has competed in, most-decorated first."
    events: [CareerEventHistory!]!
}

"Headline career totals and scoring bests."
type CareerRecordsSummary {
    events: Int!
    wins: Int!
    majors: Int!
    runnerUps: Int!
    topTens: Int!
    cutsMade: Int!
    "Best finishing position across the career; null before any counting result."
    bestFinish: Int
    "Lowest single round, with the round/tournament/when it was set; null when no round card was retained."
    lowestRound: ScoringHighlight
    "Lowest made-cut tournament total, with where and when; null before any made-cut result."
    lowestTournament: ScoringHighlight
    careerEarnings: Float!
}

"A standout scoring mark with the context that makes it a story."
type ScoringHighlight {
    "The score relative to par."
    scoreToPar: Int!
    eventName: String!
    location: String!
    season: Int!
    "ISO calendar date the event finished."
    date: String!
    "Round number (1-based) for a single-round mark; null for a tournament total."
    round: Int
}

"The player's complete history in one event, grouped by its stable name so recurring wins accumulate."
type CareerEventHistory {
    eventName: String!
    location: String!
    prestige: String!
    tier: String!
    "The tour the event belongs to (PRO or DEVELOPMENT) — the section it groups under."
    tourTier: String!
    appearances: Int!
    wins: Int!
    bestPosition: Int!
    "Every result the player recorded in this event, ordered best-first."
    results: [CareerEventResult!]!
}

"One of the player's results in an event — the when/where/how of a single appearance."
type CareerEventResult {
    season: Int!
    "ISO calendar date the event finished."
    date: String!
    position: Int!
    scoreToPar: Int!
    won: Boolean!
    madeCut: Boolean!
    location: String!
    prize: Float!
    fairwaysHit: Int!
    fairwaysPossible: Int!
    greensInRegulation: Int!
    holesPlayed: Int!
    putts: Int!
    "Each round's score relative to par, in order (empty when not retained)."
    roundScores: [Int!]!
}

type PlayerProfile {
    golferId: ID!
    firstName: String!
    lastName: String!
    nationality: String!
    age: Int!
    archetype: String!
    handedness: String!
    "World ranking position; null when the golfer is unranked."
    worldRanking: Int
    careerEarnings: Float!
    availableFunds: Float!
    "Current tour tier (enum name); null if the golfer holds no membership."
    tour: String
    events: Int!
    wins: Int!
    topTens: Int!
    "Whether the golfer has retired — their career is complete and they play no further events."
    retired: Boolean!
    attributes: [AttributeValue!]!
}

type AttributeValue {
    attribute: String!
    value: Int!
    "The ceiling this attribute can develop toward."
    potential: Int!
}

type DevelopmentDelta {
    attribute: String!
    "Points gained this season."
    delta: Int!
    season: Int!
}

type PlayerDevelopment {
    "Banked Development Points available to spend."
    points: Int!
    "Cost of the next point ≈ pointsPerRating * (1 + max(0, rating - costReference) * costGrowth)."
    pointsPerRating: Float!
    costGrowth: Float!
    costReference: Int!
}

input AttributeRaiseInput {
    "An Attribute enum name."
    attribute: String!
    "Levels to raise it by."
    points: Int!
}

type SeasonStat {
    season: Int!
    events: Int!
    wins: Int!
    topTens: Int!
    cuts: Int!
    "Best (lowest) finishing position across the season's counted events."
    bestFinish: Int!
    earnings: Float!
}

type SeasonReview {
    "The completed season this review covers."
    season: Int!
    "The player's world-ranking position at the previous season's end; null before they were ranked."
    rankStart: Int
    "The player's world-ranking position at this season's end; null if unranked."
    rankEnd: Int
    "The player's competitive stat line for the season."
    stats: SeasonStat!
    "The season's attribute development gains."
    development: [DevelopmentDelta!]!
    "The season's news, most prominent first — includes the player's own milestones (see playerGolferId)."
    headlines: [NewsItem!]!
    "The player golfer's id, so the client can split the golfer's own headlines from the wider tour's."
    playerGolferId: ID!
}

type NewsItem {
    season: Int!
    "The NewsType enum name (e.g. TOURNAMENT_VICTORY, MAJOR_VICTORY, PROMOTION, RETIREMENT)."
    type: String!
    headline: String!
    prominence: Int!
    "The subject golfer's id when the item is about a specific golfer; null otherwise."
    subjectGolferId: ID
}

type HallOfFameInduction {
    golferId: ID!
    name: String!
    season: Int!
    "The prestige-weighted score the golfer was inducted on."
    score: Float!
    careerWins: Int!
}

type RankingRow {
    "1-based position in the World Ranking."
    position: Int!
    golferId: ID!
    name: String!
    "The golfer's decayed ranking value as of now."
    rankingValue: Float!
}

type PlayerFitness {
    "AVAILABLE, RESTING, RECOVERING, or INJURED (derived)."
    availability: String!
    "Long-term physical condition in [0,1]."
    fitness: Float!
    "Accumulated fatigue in [0,1]."
    fatigue: Float!
    "Whether the golfer may enter an event unimpaired."
    canCompete: Boolean!
    "Whether the golfer could play through a recovering injury (at a shot impairment)."
    canPlayThroughInjury: Boolean!
    "The active injury, or null when healthy."
    injury: Injury
}

type Injury {
    "Body area: WRIST, BACK, SHOULDER, KNEE, ELBOW, or HAND."
    type: String!
    "MINOR, MODERATE, or SEVERE."
    severity: String!
    rehabWeeksRemaining: Int!
}

type WorldRecord {
    "MOST_CAREER_WINS, MOST_MAJOR_WINS, LOWEST_TOURNAMENT_SCORE, MOST_CONSECUTIVE_CUTS, or LONGEST_CAREER."
    type: String!
    holderGolferId: ID!
    holderName: String!
    "The record value: a count for most records, a score-to-par for LOWEST_TOURNAMENT_SCORE."
    value: Float!
    "The season the record was established."
    season: Int!
}

type SponsorshipStatus {
    "The maximum number of sponsorships that can be held at once (the concurrency cap)."
    maxConcurrent: Int!
    "The currently-active signed sponsorships."
    active: [ActiveSponsorship!]!
}

type ActiveSponsorship {
    sponsor: String!
    industry: String!
    perSeasonPayment: Float!
    "Seasons this sponsorship still has to run."
    seasonsRemaining: Int!
}

type SponsorshipOffer {
    sponsor: String!
    "The sponsor's industry (e.g. Watches, Automotive, Fashion) — identity flavour; the luxury tier is not exposed."
    industry: String!
    perSeasonPayment: Float!
    signingBonus: Float!
    durationSeasons: Int!
    grossValue: Float!
}

type StaffMember {
    role: String!
    name: String!
    age: Int!
    "Nationality enum name (e.g. USA, ESP)."
    nationality: String!
    "Descriptive personality enum name (e.g. MOTIVATOR); no gameplay effect."
    personality: String!
    quality: Float!
    hiringCost: Float!
    seasonalSalary: Float!
}

type EquipmentItem {
    name: String!
    category: String!
    "The brand behind the item (its display name); the brand biases the characteristics."
    brand: String!
    "Overall quality/tier in [0,1] — the item's budget (its mean characteristic)."
    quality: Float!
    cost: Float!
    forgiveness: Float!
    power: Float!
    workability: Float!
    feel: Float!
    "How well the item's shape suits the player's build, in [0,1] (0.5 neutral; higher complements weaknesses)."
    fit: Float!
}

type EquipmentDeal {
    "The brand offering the deal (its display name)."
    brand: String!
    "One-off signing bonus paid on accepting."
    signingBonus: Float!
    "Retainer paid each active season."
    perSeasonRetainer: Float!
    "Seasons the deal (and lock-in) runs."
    durationSeasons: Int!
    "The overall quality/tier of the bag the deal provides, in [0,1]."
    gearTier: Float!
    "How well the brand's characteristic bias suits the player's build, in [0,1] (0.5 neutral)."
    gearFit: Float!
    "The full term for a pending offer; the seasons left to run for the active deal."
    seasonsRemaining: Int!
}

type LeaderboardRow {
    position: Int!
    golfer: Golfer!
    score: Int!
    roundsPlayed: Int!
}

type RoundScorecard {
    roundNumber: Int!
    currentHole: Int!
    "Strokes relative to par over the completed holes of this round."
    toPar: Int!
    "Total strokes over the completed holes of this round."
    totalStrokes: Int!
    holes: [HoleScore!]!
}

type HoleScore {
    holeNumber: Int!
    par: Int!
    strokes: Int!
}

type CurrentEvent {
    "The event's realistic display name."
    name: String!
    "The event's place — a major's hinting location, or the host course's region."
    location: String!
    "The host course's environment classification (e.g. PARKLAND, LINKS, DESERT, MOUNTAIN) — drives scene imagery."
    courseType: String!
}

"The geometry of a hole being played, for faithful 2D rendering (spec: web-hole-visualization). Distances in yards."
type PlayingHole {
    holeNumber: Int!
    par: Int!
    length: Float!
    "Half the fairway width at the landing corridor."
    fairwayHalfWidth: Float!
    "Half the green's width."
    greenHalfWidth: Float!
    "The green's front-to-back depth."
    greenDepth: Float!
    "Cumulative elevation change over the hole (+ uphill, − downhill)."
    elevationDelta: Float!
    hasGreensideBunker: Boolean!
    hasWater: Boolean!
    hasTrees: Boolean!
    "The active round's pin lateral offset from the green centre (the pin's side is load-bearing)."
    pinLateral: Float!
    "The active round's pin depth offset (a back pin plays longer)."
    pinDepth: Float!
    "The host course's environment classification name, mapped by the client to a biome style."
    courseType: String!
    "The hole's stable seed as a string; the client derives reproducible cosmetic placement from it."
    layoutSeed: String!
    "Authoritative yard-space terrain for this hole; SVG details remain client-owned."
    geometry: PlayingGeometry!
    "The legal position and lie from which the next shot will be played."
    ball: BallState!
    "Effective local wind flow after weather, exposure, and synthetic orientation conversion."
    effectiveWind: EffectiveWind!
}

type Position {
    x: Float!
    y: Float!
}

type TerrainRegion {
    surface: String!
    boundary: [Position!]!
}

type PlayingGeometry {
    tee: Position!
    cup: Position!
    playableBoundary: [Position!]!
    regions: [TerrainRegion!]!
}

type BallState {
    position: Position!
    lie: String!
}

type ShotContact {
    position: Position!
    surface: String!
}

type ShotSettlement {
    contact: ShotContact!
    recoveryPosition: Position
    recoveryKind: String!
    ball: BallState!
}

"Authoritative spatial facts for one observable shot; airborne points are sampled from the resolver-owned path."
type ShotTrace {
    club: String!
    origin: Position!
    aimPoint: AimPoint!
    contact: ShotContact!
    airbornePath: [AirbornePoint!]!
    roll: ShotTraceRoll
    transition: ShotTraceTransition
    finalPoint: Position!
}
type AirbornePoint { progress: Float!, position: Position!, height: Float! }

"Read-only signed wind flow in canonical hole coordinates; it describes where air moves toward, not a compass bearing."
type EffectiveWind { x: Float!, y: Float!, magnitude: Float!, unit: String! }

"One authoritative post-contact ground-response endpoint, distinct from rules recovery."
type ShotTraceRoll {
    from: Position!
    to: Position!
}

"A rules recovery or replay, explicitly distinct from ball flight."
type ShotTraceTransition {
    kind: String!
    from: Position!
    to: Position!
}

type ShotSituation {
    holeNumber: Int!
    par: Int!
    shotNumber: Int!
    strokesThisHole: Int!
    distanceToPin: Float!
    lie: String!
    pinLateral: Float!
    minReach: Float!
    maxReach: Float!
    "The reachable surface profile — ordered distance bands the shot could find — for a truthful shot-preview overlay."
    reachable: [SurfaceBand!]!
    "Opaque concurrency token for this exact pending shot."
    shotRevision: String!
    aimEnvelope: AimEnvelope
    guidance: ShotGuidance
}

type AimEnvelope { minX: Float!, maxX: Float!, minY: Float!, maxY: Float! }
type AimPoint { x: Float!, y: Float! }
type ShotShapeAvailability { shape: String!, available: Boolean!, reason: String }
type ShotFamilyAvailability { family: String!, available: Boolean!, reason: String, shapes: [ShotShapeAvailability!]! }
type ClubReach { club: String!, label: String!, nominalCarry: Float!, normalReach: Float!, families: [ShotFamilyAvailability!]! }
type ShotGuidance { safe: AimPoint!, primary: AimPoint!, aggressive: AimPoint!, clubs: [ClubReach!]! }
type ShotSubmission { outcome: ShotOutcome, stale: Boolean! }

"One distance band of a shot's reachable surface profile (spec: web-hole-visualization). Distances in yards."
type SurfaceBand {
    "Nearest carry covered by this band."
    startDistance: Float!
    "Farthest carry covered by this band (exclusive)."
    endDistance: Float!
    "Lateral regions from the centre outward; beyond the widest is out of bounds."
    regions: [SurfaceRegion!]!
}

"One lateral region within a reachable surface band: a surface out to a cumulative half-width from centre."
type SurfaceRegion {
    "The Surface enum name (e.g. FAIRWAY, PRIMARY_ROUGH, BUNKER, WATER)."
    surface: String!
    "Cumulative lateral extent from the centre, in yards."
    halfWidth: Float!
}

type Save {
    saveId: ID!
    savedAt: String!
    season: Int!
    week: Int!
    playerGolferId: ID
}

type ShotOutcome {
    finalSurface: String!
    carry: Float!
    lateral: Float!
    distanceRemaining: Float!
    hazardEntered: Boolean!
    penaltyStrokes: Int!
    strokes: Int!
    settlement: ShotSettlement
    trace: ShotTrace
}

input AimPointInput { x: Float!, y: Float! }
input BallStrikeIntentInput {
    club: String!
    aimPoint: AimPointInput!
    shotFamily: String
    shotShape: String
    expectedShotRevision: String!
}

"A self-chosen career goal. type is a GoalType enum name; target defaults to 1 (boolean-style goal) when omitted."
input CareerGoalInput {
    type: String!
    target: Long
}

"Explicit world configuration; every field is optional and falls back to the engine default when omitted."
input WorldConfigInput {
    populationSize: Int
    weeksPerSeason: Int
    eventsPerTierPerSeason: Int
    fieldSize: Int
    coursePoolSize: Int
    majorsPerSeason: Int
    signatureEventsPerTier: Int
}
