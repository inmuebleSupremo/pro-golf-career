# Copy this file to .env before starting the backend or Docker Compose.
# Replace the placeholder with a unique local secret of at least 32 characters. Do not commit .env.
PROGOLF_JWT_SECRET=replace-with-a-unique-local-secret-at-least-32-characters
# Optional: true makes only newly created worlds use experimental refined V5 (generator 7).
# Existing saves remain pinned to their original generator. Leave false for normal generation.
PROGOLF_REFINED_V5_NEW_WORLDS=false
# Optional: true makes only newly created worlds use principles-driven Generator 8.
# Existing saves remain pinned to their original generator. Generator 8 takes precedence if both opt-ins are true.
# Leave false for normal generation.
PROGOLF_PRINCIPLED_ARCHITECTURE_NEW_WORLDS=false
